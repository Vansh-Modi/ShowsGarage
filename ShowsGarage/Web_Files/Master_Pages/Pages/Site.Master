<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="ShowsGarage.Web_Files.Master_Pages.Pages.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Vansh Modi" />
    <meta name="designer" content="Vansh Modi" />
    <link href="../Styles/siteMaster.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/Web_Files/Images/icons/Show's Garage Logo BG.png" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="masterPage" runat="server">
        <div class="wrapper">
            <header>
                <div id="nav-bar">
                    <div class="header-top">
                        <div id="logo-section">
                            <asp:ImageButton ID="ibLogo" runat="server" ImageUrl="~/Web_Files/Images/icons/Show's Garage Logo(Master Page BG).png" PostBackUrl="~/homePage.aspx" CssClass="logo-img" CausesValidation="False" OnClick="ibLogo_Click" />
                        </div>

                        <div id="search-bar">
                            <asp:TextBox ID="txtSearch" runat="server" placeholder="Search car"></asp:TextBox>
                            <asp:ImageButton ID="imgSearch" runat="server" ImageUrl="~/Web_Files/Images/icons/search-icon.png" CssClass="search-icon" ImageAlign="Middle" />
                        </div>


                        <div id="utility-buttons">
                            <asp:Panel ID="Panel1" runat="server" CssClass="icon-group">
                                <asp:ImageButton ID="ibUserCart" runat="server" ImageUrl="~/Web_Files/Images/icons/cart-icon.png" CssClass="nav-icon" EnableViewState="False" PostBackUrl="~/Web_Files/Client/Pages/cart.aspx" CausesValidation="False" />
                                <asp:ImageButton ID="ibUserAccount" runat="server" ImageUrl="~/Web_Files/Images/icons/account-icon.png" CssClass="nav-icon" PostBackUrl="~/Web_Files/Client/Pages/profile.aspx" CausesValidation="False" />
                                <asp:ImageButton ID="ibUserLogout" runat="server" ImageUrl="~/Web_Files/Images/icons/logout.png" CssClass="nav-icon" OnClick="ibUserLogout_Click" CausesValidation="False" />
                            </asp:Panel>

                            <asp:Panel ID="Panel2" runat="server" Visible="false" CssClass="icon-group">
                                <asp:ImageButton ID="ibAdminAccount" runat="server" ImageUrl="~/Web_Files/Images/icons/account-icon.png" CssClass="nav-icon" PostBackUrl="~/Web_Files/Admin/Pages/account.aspx" CausesValidation="False" />
                                <asp:ImageButton ID="ibAdminLogout" runat="server" ImageUrl="~/Web_Files/Images/icons/logout.png" CssClass="nav-icon" OnClick="ibAdminLogout_Click" CausesValidation="False" />
                            </asp:Panel>
                        </div>
                    </div>
                </div>

                <div class="header-bottom">
                    <asp:Panel ID="pnlUserNav" runat="server">
                        <nav id="user-nav">
                            <ul>
                                <li><a href="../../../homePage.aspx">Home</a></li>
                                <li><a href="../../../Web_Files/Client/Pages/shop.aspx">Collections</a></li>
                                <li><a href="../../../Web_Files/Client/Pages/myOrders.aspx">Orders</a></li>
                                <li><a href="../../../Web_Files/Client/Pages/cart.aspx">About Us</a></li>
                            </ul>
                        </nav>
                    </asp:Panel>

                    <asp:Panel ID="pnlAdminNav" runat="server" Visible="false">
                        <nav id="admin-nav">
                            <ul>
                                <li><a href="../../../Web_Files/Admin/Pages/dashboard.aspx">Dashboard</a></li>
                                <li><a href="../../../Web_Files/Admin/Pages/products.aspx">Inventory</a></li>
                                <li><a href="../../../Web_Files/Admin/Pages/users.aspx">Users</a></li>
                                <li><a href="../../../Web_Files/Admin/Pages/reports.aspx">P/L Report</a></li>
                                <li><a href="../../../Web_Files/Admin/Pages/expenses.aspx">Expenses</a></li>
                                <li><a href="../../../Web_Files/Admin/Pages/siteSettings.aspx">Site Settings</a></li>
                                <li><a href="../../../Web_Files/Admin/Pages/orders.aspx">Orders</a></li>
                            </ul>
                        </nav>
                    </asp:Panel>
                </div>
            </header>

            <div class="main-container">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
            </div>

            <footer>
                <div class="footer-content">
                    <div class="footer-section">
                        <h4 class="gold-text">SHOWS GARAGE</h4>
                        <p>Your premium destination for precision collectibles.</p>
                        <div class="social-links">
                        </div>
                    </div>

                    <div class="footer-section">
                        <h4>Collections</h4>
                        <a href="../../Client/Pages/shop.aspx">Hot Wheels</a>
                        <a href="../../Client/Pages/shop.aspx">Mini GT</a>
                    </div>

                    <div class="footer-section">
                        <h4>Customer Service</h4>
                        <a href="/Web_Files/Others/contactUs.aspx">Contact Us</a>
                        <a href="/Web_Files/Others/Shipping.aspx">Shipping Info</a>
                        <a href="/Web_Files/Others/privacy.aspx">Privacy Policy</a>
                    </div>

                    <div class="footer-section">
                        <h4>Stay Updated</h4>
                        <p>Join the garage for new case drops and exclusive diecast news.</p>
                        <div class="newsletter-container">
                            <asp:TextBox ID="txtFooterEmail" runat="server" CssClass="footer-input" placeholder="Your Email Address"></asp:TextBox>
                            <asp:LinkButton ID="btnFooterJoin" runat="server" CssClass="footer-btn" OnClick="btnFooterJoin_Click">
                                JOIN
                            </asp:LinkButton>
                        </div>
                    </div>
                </div>
                <div class="footer-bottom">
                    &copy; 2026 Shows Garage | Crafted for Hobbyists <a href="/Web_Files/Master_Pages/Pages/DeveloperProfile.aspx" class="developer-link">Vansh Modi</a>
                    <script>
                        console.log("%c🚀 Shows Garage %cBuilt by Vansh Modi",
                            "color: #D4AF37; font-size: 20px; font-weight: bold;",
                            "color: #005461; font-size: 14px;");
                        console.log("Contact: vanshmodi268@gmail.com | Version: 1.0.0");
                    </script>
                </div>
            </footer>
        </div>
    </form>
</body>
</html>
